# Copy this file to .env and fill in what you have. Everything here is
# optional -- with no .env file, the app runs on the bundled synthetic
# sample data (pipeline/generate_sample_data.py) and pipeline/collect.py
# will just print setup instructions instead of doing anything.

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials).
# Free tier: 10,000 quota units/day. search.list costs 100 units,
# commentThreads.list costs 1 unit -- see DATA_SOURCES.md.
YOUTUBE_API_KEY=

# Twitter/X: real historical search access requires a paid API tier as of
# 2023. Set this to "true" to also attempt a best-effort snscrape pass
# (frequently blocked by X's current rate limiting -- see DATA_SOURCES.md).
TWITTER_TRY_SNSCRAPE=false

# Fallback for X: path to a CSV manually exported from the X web search UI
# (documented as a "convenience sample" per PROJECT_INSTRUCTIONS.md).
# Expected columns: text, timestamp, likes, retweets, author_id
TWITTER_MANUAL_EXPORT_CSV=

# Facebook has no reliable free public API since the Cambridge-Analytica-era
# lockdowns (DATA_SOURCES.md). Path to a manual/CrowdTangle export CSV.
# Expected columns: text, timestamp, page_name, reactions
FACEBOOK_MANUAL_EXPORT_CSV=
