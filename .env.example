# Copy this file to .env and fill in what you have. Everything below
# YouTube_API_KEY is optional -- with no .env file, the app runs on the
# bundled synthetic sample data (pipeline/generate_sample_data.py) and
# pipeline/collect.py will just print setup instructions instead of doing
# anything.

# PostgreSQL connection string used by pipeline/db.py and the FastAPI app.
# The default below matches docker-compose.yml's `db` service; if you're
# running Postgres yourself (not via docker-compose), point this at it
# instead. Required -- there is no bundled/embedded fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cg_foods_sentiment

# Only used by docker-compose.yml to configure the `db` service itself
# (ignored if you're running your own Postgres and setting DATABASE_URL
# directly).
POSTGRES_DB=cg_foods_sentiment
POSTGRES_USER=postgres
# Host-side port the `db` service publishes on (change if 5432 is already
# taken on your machine -- update DATABASE_URL's port to match if you do).
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=postgres

# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials).
# Free tier: 10,000 quota units/day. search.list costs 100 units,
# commentThreads.list costs 1 unit -- see DATA_SOURCES.md.
YOUTUBE_API_KEY=

# Optional, off by default: resolve each commenter's channel-declared
# country (self-reported, most users never set it) for the region field via
# an extra channels.list call per unique commenter. Costs additional quota
# -- see DATA_SOURCES.md's Region Heuristic section.
YOUTUBE_RESOLVE_COMMENTER_REGION=false

# Twitter/X: real historical search access requires a paid API tier as of
# 2023. Set this to "true" to also attempt a best-effort snscrape pass
# (frequently blocked by X's current rate limiting -- see DATA_SOURCES.md).
TWITTER_TRY_SNSCRAPE=false

# Fallback for X: path to a CSV manually exported from the X web search UI
# (documented as a "convenience sample" per PROJECT_INSTRUCTIONS.md).
# Expected columns: text, timestamp, likes, retweets, author_id, location
# (location is optional -- the profile's free-text location field, used as
# a best-effort region signal; see DATA_SOURCES.md)
TWITTER_MANUAL_EXPORT_CSV=

# Facebook has no reliable free public API since the Cambridge-Analytica-era
# lockdowns (DATA_SOURCES.md). Path to a manual/CrowdTangle export CSV.
# Expected columns: text, timestamp, page_name, reactions
FACEBOOK_MANUAL_EXPORT_CSV=
